<?xml version="1.0" encoding="utf-8"?>
<!--
    Note/notice box background.
    Faint amber tint (left accent bar look via stroke) to signal "heads-up" info
    without clashing with the cyan theme.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#141F1B12" />

    <corners android:radius="12dp" />

    <stroke
        android:width="1dp"
        android:color="#26FFC940" />

</shape>