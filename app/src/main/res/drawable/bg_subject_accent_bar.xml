<?xml version="1.0" encoding="utf-8"?>
<!--
    Thin vertical accent bar placed beside the subject title.
    Gives the header a premium "card indicator" look.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#00E5FF"
        android:endColor="#0091FF" />

    <corners android:radius="3dp" />

</shape>