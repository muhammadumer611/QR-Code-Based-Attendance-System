<?xml version="1.0" encoding="utf-8"?>
<!--
    Circular delete button background with ripple feedback.
    Faint red glass fill so the icon "pops" without being loud.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33D92D20">

    <item>
        <shape android:shape="oval">
            <solid android:color="#1AD92D20" />
            <stroke
                android:width="1dp"
                android:color="#33D92D20" />
        </shape>
    </item>

</ripple>