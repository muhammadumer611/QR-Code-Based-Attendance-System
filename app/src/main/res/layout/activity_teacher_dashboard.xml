<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".ActivityTeacherDashboard">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backgroundColor">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/backgroundColor"
                android:paddingBottom="24dp">

                <!-- ================= PREMIUM HEADER ================= -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="290dp"
                    android:background="@drawable/bg_teacher_header">

                    <ImageView
                        android:id="@+id/menuIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="24dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/cyanAccent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/profileImage"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="18dp"
                        app:cardCornerRadius="26dp"
                        app:cardBackgroundColor="#1A1F26"
                        app:strokeColor="@color/cyanAccent"
                        app:strokeWidth="1.5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/imgProfile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:src="@drawable/outline_account_circle_24"
                            app:tint="@color/cyanAccent"/>

                    </com.google.android.material.card.MaterialCardView>

                    <ImageView
                        android:id="@+id/notification"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/cyanAccent"
                        app:layout_constraintEnd_toStartOf="@id/profileImage"
                        app:layout_constraintTop_toTopOf="@id/profileImage"
                        app:layout_constraintBottom_toBottomOf="@id/profileImage"/>

                    <TextView
                        android:id="@+id/txtHello"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Morning 👋"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        android:letterSpacing="0.02"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="55dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/menuIcon"/>

                    <TextView
                        android:id="@+id/txtWelcome"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/txtTeacher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="Muhammad Umer"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintStart_toStartOf="@id/txtHello"
                        app:layout_constraintTop_toBottomOf="@id/txtHello"/>

                    <TextView
                        android:id="@+id/txtTeacherName"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/txtRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="Senior Faculty • CS Department"
                        android:textColor="@color/cyanAccent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:layout_marginTop="2dp"
                        app:layout_constraintStart_toStartOf="@id/txtHello"
                        app:layout_constraintTop_toBottomOf="@id/txtTeacher"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/searchCard"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="22dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#00000000"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp"
                        app:layout_constraintTop_toBottomOf="@id/txtRole"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_search_glass"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_search"
                                app:tint="@color/cyanAccent"/>

                            <EditText
                                android:id="@+id/etSearchStudents"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="Search Students..."
                                android:inputType="text"
                                android:imeOptions="actionSearch"
                                android:textColor="@android:color/white"
                                android:textColorHint="@color/textSecondary"
                                android:textSize="14sp"
                                android:paddingStart="12dp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ================= STATISTICS ROW 1 ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:paddingHorizontal="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_shedule"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Assigned Subjects"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/tvAssignedSubjects"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@android:color/white"
                                android:textSize="26sp"
                                android:textStyle="bold"/>

                            <!-- Old ID compatibility -->
                            <TextView
                                android:id="@+id/txtTotalClasses"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_students"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Students"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/tvTotalStudents"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@android:color/white"
                                android:textSize="26sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtTotalStudents"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ================= STATISTICS ROW 2 ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_attendance"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Attendance"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/tvAttendancePercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/cyanAccent"
                                android:textStyle="bold"
                                android:textSize="26sp"/>

                            <TextView
                                android:id="@+id/txtAttendancePercentage"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAssignments"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_reporsts"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Assignments"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/tvAssignmentsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="26sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ================= MY SUBJECTS ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Subjects"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvViewAllSubjects"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textColor="@color/cyanAccent"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerMySubjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:paddingVertical="10dp"
                    android:orientation="horizontal"
                    tools:listitem="@layout/item_subject_card"/>

                <TextView
                    android:id="@+id/txtSubjectsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No subjects assigned yet. Contact Admin to get subjects assigned."
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="20dp"
                    android:visibility="gone"/>

                <!-- ================= QUICK ACTIONS ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:text="Quick Actions"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:columnCount="2">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTakeAttendance"
                        android:layout_width="0dp"
                        android:layout_height="176dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="14dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccent"
                        app:strokeWidth="1.5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glass_card_glow"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="28dp"
                                app:cardBackgroundColor="#2600E5FF">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_qr_code"
                                    app:tint="@color/cyanAccent"/>

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Take Attendance"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginTop="14dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QR Scanner"
                                android:textColor="@color/cyanAccent"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManualAttendance"
                        android:layout_width="0dp"
                        android:layout_height="176dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Manual Attendance"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:layout_marginTop="14dp"
                                android:gravity="center"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edit Records"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardUploadNotes"
                        android:layout_width="0dp"
                        android:layout_height="176dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_upload"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Upload Notes"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:layout_marginTop="14dp"
                                android:gravity="center"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAssignmentsAction"
                        android:layout_width="0dp"
                        android:layout_height="176dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_assignment"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Assignments"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:layout_marginTop="14dp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStudents"
                        android:layout_width="0dp"
                        android:layout_height="176dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_students"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Students"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:layout_marginTop="14dp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardResults"
                        android:layout_width="0dp"
                        android:layout_height="176dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/glassCard"
                        app:strokeColor="@color/cyanAccentDim"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_results"
                                app:tint="@color/cyanAccent"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Results"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:layout_marginTop="14dp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- ================= ATTENDANCE ANALYTICS ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance Analytics"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/glassCard"
                    app:strokeColor="@color/cyanAccentDim"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Overall Attendance"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"/>

                        <ProgressBar
                            android:id="@+id/progressAttendance"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/cyanAccent"
                            android:progressBackgroundTint="#262C33"
                            android:layout_marginTop="16dp"/>

                        <TextView
                            android:id="@+id/tvAttendanceSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0% Students Present"
                            android:textStyle="bold"
                            android:textColor="@color/cyanAccent"
                            android:textSize="13sp"
                            android:layout_marginTop="10dp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ================= RECENT ACTIVITIES ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Activities"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="4dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecent"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_margin="16dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/txtRecentEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activity feed will appear here once this module is connected."
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="20dp"/>

                <!-- ================= UPCOMING CLASSES ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Classes"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="20dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/glassCard"
                    app:strokeColor="@color/cyanAccentDim"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/todayClassesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtNoTodayClasses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No classes assigned for today."
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This section will show your scheduled classes with time and room once the timetable feature is connected."
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Compatibility IDs for old Kotlin code -->

                <TextView
                    android:id="@+id/btnMyClasses"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/btnAttendance"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- ================= LOADING OVERLAY ================= -->

        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/backgroundColor"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/cyanAccent"/>

        </FrameLayout>

        <!-- ================= ERROR STATE ================= -->

        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Something went wrong."
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tap to retry"
                android:textColor="@color/cyanAccent"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- ================= FLOATING ACTION BUTTON ================= -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAttendance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:src="@drawable/ic_qr_code"
            app:tint="@color/backgroundColor"
            app:backgroundTint="@color/cyanAccent"
            app:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= NAVIGATION DRAWER ================= -->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/backgroundColor"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_teacher"
        app:menu="@menu/teacher_drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>

