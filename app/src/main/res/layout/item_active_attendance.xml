<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_marginHorizontal="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/tvLive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE • Attendance Open" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:id="@+id/tvQrHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live QR received from teacher. You do not need to scan it." android:textSize="12sp" android:layout_marginTop="4dp"/>
        <ImageView android:id="@+id/imgLiveQr" android:layout_width="220dp" android:layout_height="220dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:background="@android:color/white" android:padding="8dp" android:contentDescription="Teacher live attendance QR"/>
        <TextView android:id="@+id/tvSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subject" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/tvTeacher" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Teacher" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/tvClass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Class" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/tvTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Time" android:layout_marginTop="2dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="52dp" android:text="Save Attendance" android:textAllCaps="false" android:layout_marginTop="12dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
