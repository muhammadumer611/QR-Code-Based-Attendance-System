<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/backgroundColor">


    <!-- HEADER -->

    <LinearLayout

        android:id="@+id/header"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:padding="18dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView

            android:id="@+id/btnBack"

            android:layout_width="42dp"
            android:layout_height="42dp"

            android:padding="10dp"

            android:background="@drawable/bg_icon_circle_glass"

            android:src="@drawable/ic_arrow"

            app:tint="@color/textPrimary" />


        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:layout_marginStart="14dp"

            android:text="My Attendance"

            android:textColor="@color/textPrimary"
            android:textSize="21sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- STUDENT INFO -->

    <com.google.android.material.card.MaterialCardView

        android:id="@+id/studentCard"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginHorizontal="16dp"

        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"

        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="18dp"

            android:background="@drawable/bg_glass_card_cyan">

            <TextView

                android:id="@+id/tvStudentName"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Student Name"

                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView

                android:id="@+id/tvStudentInfo"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:text="Registration • Program • Semester"

                android:textColor="@color/textSecondary"
                android:textSize="12sp" />


            <TextView

                android:id="@+id/tvOverallAttendance"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:text="Overall Attendance: 85%"

                android:textColor="@color/colorPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- WARNING -->

    <TextView

        android:id="@+id/tvAlert"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"

        android:padding="16dp"

        android:textColor="#FF5252"
        android:textSize="13sp"
        android:textStyle="bold"

        android:background="@drawable/bg_attendance_warning"

        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/studentCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- SECTION -->

    <TextView

        android:id="@+id/tvSectionTitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="18dp"

        android:text="Subject-wise Attendance"

        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/tvAlert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- EMPTY -->

    <TextView

        android:id="@+id/tvEmptyState"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_margin="30dp"

        android:gravity="center"

        android:text="No attendance history available yet."

        android:textColor="@color/textSecondary"
        android:textSize="14sp"

        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- SUBJECT LIST -->

    <androidx.recyclerview.widget.RecyclerView

        android:id="@+id/recyclerSubjects"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_marginTop="8dp"

        android:clipToPadding="false"

        android:paddingBottom="24dp"

        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- LOADING -->

    <ProgressBar

        android:id="@+id/progressBar"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:indeterminateTint="@color/colorPrimary"

        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>