<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="File Name"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etFileName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="e.g. Semester_5_Schedule.pdf"
        android:inputType="text"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:background="@drawable/bg_search_glass"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Note / Link (optional)"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etNote"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="e.g. Google Drive link or description"
        android:inputType="textUri"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:background="@drawable/bg_search_glass"
        android:padding="12dp" />

</LinearLayout>