<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/glassCard"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/cyanAccentDim"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- ================================================= -->
        <!-- DATE / DAY -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_qr_glow">

            <TextView
                android:id="@+id/tvClassDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WED"
                android:textColor="@color/cyanAccent"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvClassDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="22sp"
                android:gravity="center"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CLASS INFORMATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mobile Application Development"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="BSCS - 5th Semester"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="7dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/cyanAccent"/>

                <TextView
                    android:id="@+id/tvClassTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="09:00 AM - 10:00 AM"
                    android:textColor="@color/cyanAccent"
                    android:textStyle="bold"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Room 204"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ARROW -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imgArrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/cyanAccent"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

