<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgStudentAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/onboard1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student"
                    android:textColor="@color/textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvStudentMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Program"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_notification"
                android:contentDescription="Notifications"/>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="@color/textSecondary"/>

                <TextView
                    android:id="@+id/tvTodayStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvTodayStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live attendance status"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"/>

                <TextView
                    android:id="@+id/tvNextClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Class"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TODAY'S CLASSES -->

        <TextView
            android:id="@+id/tvTodayClassesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today's Classes"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tvTodayClassesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No class is scheduled for your class today."
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTodayClasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="6dp"/>

        <!-- LIVE ATTENDANCE -->

        <TextView
            android:id="@+id/tvLiveAttendanceEmptyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Attendance"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tvLiveAttendanceEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When your teacher starts attendance, the live QR will appear here. No camera or scanning is required."
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActiveAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <!-- Legacy IDs kept for compatibility -->

        <android.widget.Button
            android:id="@+id/btnScanQr"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvScanHint"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTotalClasses"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAttendancePercent"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStreakCount"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSeeAllHistory"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAttendanceHistory"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:id="@+id/main"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:id="@+id/warningBanner"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:id="@+id/appBarLayout"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:id="@+id/collapsingToolbar"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:id="@+id/bottomNav"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>